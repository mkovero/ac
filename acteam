#!/usr/bin/env bash
# ac-team — agent workflow runner for mkovero/ac
# place this at the repo root or on PATH
# usage: ac-team <command> [args]

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENTS="$REPO_ROOT/.agents"
AUDIT_DIR="$REPO_ROOT/audit"
REPO="mkovero/ac"

# colours
RED='\033[0;31m'
YEL='\033[0;33m'
GRN='\033[0;32m'
DIM='\033[2m'
NC='\033[0m'

# ── helpers ────────────────────────────────────────────────────────────────────

die()  { echo -e "${RED}error:${NC} $*" >&2; exit 1; }
info() { echo -e "${DIM}▸ $*${NC}"; }
ok()   { echo -e "${GRN}✓${NC} $*"; }
warn() { echo -e "${YEL}!${NC} $*"; }

require_agent() {
    [[ -f "$AGENTS/$1.md" ]] || die "agent spec not found: $AGENTS/$1.md"
}

require_env() {
    # prefer existing GITHUB_TOKEN, otherwise pull from gh cli
    if [[ -z "${GITHUB_TOKEN:-}" ]]; then
        GITHUB_TOKEN="$(gh auth token 2>/dev/null)"             || die "not logged into GitHub — run: gh auth login"
        export GITHUB_TOKEN
    fi
}

confirm() {
    local msg="$1"
    echo -e "${YEL}?${NC} $msg [y/N] " >&2
    read -r reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

run_agent() {
    local spec="$1"; shift
    require_agent "$spec"
    info "running $spec agent..."
    claude -p --system-prompt-file "$AGENTS/$spec.md" "$@"
}

run_agent_interactive() {
    local spec="$1"; shift
    require_agent "$spec"
    info "running $spec agent (interactive)..."
    claude -p --system-prompt-file "$AGENTS/$spec.md" "$@"
}

# ── commands ───────────────────────────────────────────────────────────────────

cmd_help() {
    cat << 'EOF'
ac-team — agent workflow runner

ISSUE WORKFLOW
  ac-team triage  "<description>"     triage a new issue (creates it in GitHub)
  ac-team design  <issue-number>      run architect on a needs-design issue
  ac-team ux      <issue-number>      run UX agent on a needs-ux issue
  ac-team impl    <issue-number>      implement a ready-to-implement issue
  ac-team review  <pr-number>         QA review of an open PR

AUDIT WORKFLOW
  ac-team audit                       full audit: all specialists + consolidated report
  ac-team audit:architect             architect audit only
  ac-team audit:ux                    UX audit only
  ac-team audit:qa                    QA audit only
  ac-team audit:consolidate           consolidate existing raw audit files
  ac-team audit:propose               propose issues from latest audit (no posting)
  ac-team audit:file                  create issues from proposed-issues.md

DRAIN
  ac-team drain                       implement the highest-priority ready-to-implement issue
  ac-team ux:drain                    process all open needs-ux issues

OTHER
  ac-team status                      show open issues by label
  ac-team help                        this message

ENVIRONMENT
  GITHUB_TOKEN    optional — falls back to gh auth token if not set
  AC_INTERACTIVE  set to 1 to use interactive mode instead of -p (lets you watch)
EOF
}

cmd_triage() {
    [[ $# -ge 1 ]] || die "usage: ac-team triage \"<description>\""
    require_env
    local desc="$*"
    info "triaging: $desc"
    run_agent_interactive triage \
        "Triage this issue and create it in $REPO: $desc"
}

cmd_design() {
    [[ $# -eq 1 ]] || die "usage: ac-team design <issue-number>"
    require_env
    local n="$1"
    info "architect reviewing issue #$n"
    run_agent_interactive architect \
        "Review issue #$n in $REPO (labeled needs-design). Produce a design decision comment, then apply design-approved and ready-to-implement labels."
}

cmd_ux() {
    [[ $# -eq 1 ]] || die "usage: ac-team ux <issue-number>"
    require_env
    local n="$1"
    info "UX agent reviewing issue #$n"
    run_agent_interactive ux \
        "Review issue #$n in $REPO (labeled needs-ux). Produce a design comment, then apply ux-approved and ready-to-implement labels (or needs-discussion if blocked)."
}

cmd_impl() {
    [[ $# -eq 1 ]] || die "usage: ac-team impl <issue-number>"
    require_env
    local n="$1"
    info "implementing issue #$n"
    run_agent_interactive developer \
        "Implement issue #$n in $REPO."
}

cmd_review() {
    [[ $# -eq 1 ]] || die "usage: ac-team review <pr-number>"
    require_env
    local n="$1"
    info "QA reviewing issue #$n"
    run_agent_interactive qa \
        "Review issue #$n in $REPO. Post a structured review comment and apply appropriate labels."
}

cmd_drain() {
    require_env
    info "looking for highest-priority ready-to-implement issue..."
    run_agent_interactive developer \
        "Find the highest-priority open issue labeled ready-to-implement in $REPO and implement it."
}

cmd_ux_drain() {
    require_env
    info "processing all needs-ux issues in $REPO..."
    run_agent_interactive ux \
        "Find all open issues in $REPO labeled needs-ux. For each one: read the issue and any existing triage spec comment, produce a design comment, then apply ux-approved and ready-to-implement and remove needs-ux. If an issue has a blocking question apply needs-discussion instead and do not apply ready-to-implement. Process them one by one until the needs-ux queue is empty."
}

cmd_audit_specialist() {
    local spec="$1"
    local label="$2"
    local prompt="$3"
    local outfile="$AUDIT_DIR/${spec}-raw.md"

    require_agent "$spec"
    mkdir -p "$AUDIT_DIR"
    info "$label audit → $outfile"

    if [[ "${AC_INTERACTIVE:-0}" == "1" ]]; then
        run_agent_interactive "$spec" "$prompt" | tee "$outfile"
    else
        run_agent "$spec" "$prompt" | tee "$outfile"
    fi
    ok "$label audit written to $outfile"
}

cmd_audit_architect() {
    cmd_audit_specialist architect "architect" \
        "Audit the full codebase. Read all source files under ac-rs/. Produce the architect audit report."
}

cmd_audit_ux() {
    cmd_audit_specialist ux "ux" \
        "Audit the full codebase. Read all stdout-producing code across ac-rs/. Produce the ux audit report."
}

cmd_audit_qa() {
    cmd_audit_specialist qa "qa" \
        "Audit the full codebase. Read all tests and measurement-producing code. Read stddocs/ for applicable standards. Produce the qa audit report."
}

cmd_audit_consolidate() {
    local date
    date="$(date +%F)"
    local outfile="$AUDIT_DIR/audit-$date.md"

    require_agent audit
    mkdir -p "$AUDIT_DIR"

    for f in architect-raw ux-raw qa-raw; do
        [[ -f "$AUDIT_DIR/$f.md" ]] || die "missing $AUDIT_DIR/$f.md — run ac-team audit:$( echo "$f" | cut -d- -f1) first"
    done

    info "consolidating audit → $outfile"
    run_agent audit \
        "Read audit/architect-raw.md, audit/ux-raw.md, and audit/qa-raw.md. Produce the consolidated audit report and write it to $outfile." \
        | tee "$outfile"
    ok "consolidated report written to $outfile"
}

cmd_audit() {
    warn "running full audit — this will take a while"
    confirm "continue?" || exit 0

    cmd_audit_architect
    cmd_audit_ux
    cmd_audit_qa
    cmd_audit_consolidate

    ok "audit complete"
    echo ""
    echo "next step:"
    echo "  ac-team audit:propose    preview issues before posting"
}

cmd_audit_propose() {
    local date
    date="$(date +%F)"
    local report="$AUDIT_DIR/audit-$date.md"
    local proposed="$AUDIT_DIR/proposed-issues.md"

    [[ -f "$report" ]] || {
        # try any audit file if today's isn't there
        report="$(ls -t "$AUDIT_DIR"/audit-*.md 2>/dev/null | head -1)"
        [[ -n "$report" ]] || die "no audit report found in $AUDIT_DIR — run ac-team audit first"
        warn "using $report"
    }

    require_agent triage
    info "proposing issues from $report → $proposed"

    run_agent triage \
        "Read $report. List the GitHub issues you would create — title, category, labels, one-line rationale each. Do not create anything yet. Output as a plain numbered list." \
        | tee "$proposed"

    ok "proposed issues written to $proposed"
    echo ""
    echo "review and edit $proposed, then run:"
    echo "  ac-team audit:file"
}

cmd_audit_file() {
    local proposed="$AUDIT_DIR/proposed-issues.md"
    local date
    date="$(date +%F)"
    local report
    report="$(ls -t "$AUDIT_DIR"/audit-*.md 2>/dev/null | head -1)"

    [[ -f "$proposed" ]] || die "no proposed-issues.md found — run ac-team audit:propose first"
    [[ -n "$report" ]]   || die "no audit report found in $AUDIT_DIR"

    require_env
    warn "this will create issues in $REPO"
    confirm "continue?" || exit 0

    info "filing issues from $proposed"
    run_agent_interactive triage \
        "Read $proposed and $report. Create exactly the issues listed in $proposed in $REPO. Use the audit report for full context when writing each issue body. Apply label audit-finding in addition to category labels."
    ok "issues filed"
}

cmd_status() {
    require_env
    info "fetching open issues from $REPO..."
    claude -p \
        "List all open issues in $REPO grouped by label. Show: issue number, title, labels. Format as a plain text table. Focus on labels: needs-design, needs-ux, needs-discussion, ready-to-implement, in-review, needs-work, blocked."
}

# ── dispatch ───────────────────────────────────────────────────────────────────

[[ $# -ge 1 ]] || { cmd_help; exit 0; }

case "$1" in
    triage)           shift; cmd_triage "$@" ;;
    design)           shift; cmd_design "$@" ;;
    ux)               shift; cmd_ux "$@" ;;
    impl)             shift; cmd_impl "$@" ;;
    review)           shift; cmd_review "$@" ;;
    drain)            cmd_drain ;;
    ux:drain)         cmd_ux_drain ;;
    audit)            cmd_audit ;;
    audit:architect)  cmd_audit_architect ;;
    audit:ux)         cmd_audit_ux ;;
    audit:qa)         cmd_audit_qa ;;
    audit:consolidate) cmd_audit_consolidate ;;
    audit:propose)    cmd_audit_propose ;;
    audit:file)       cmd_audit_file ;;
    status)           cmd_status ;;
    help|--help|-h)   cmd_help ;;
    *)                die "unknown command: $1 — run ac-team help" ;;
esac
